  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Kamu terjaga di sebuah pulau misteri, diselubungi kabus dan kesunyian.
    Tiada peta, tiada panduan \u2014 hanya sisa-sisa kehancuran yang membawamu ke
    sini. Pulau ini seolah-olah hidup: hutannya menyimpan rahsia, runtuhannya berbisik
    tentang mereka yang pernah datang sebelum ini, dan bahayanya semakin meningkat
    setiap hari yang berlalu.\n\nUntuk melarikan diri, kamu mesti memilih jalanmu.
    Adakah kamu akan menguasai kemahiran bertahan hidup \u2014 mencipta alat, membina
    tempat perlindungan, dan mengharungi hutan liar \u2014 atau adakah kamu akan
    menurut panggilan pengembaraan, membongkar misteri tersembunyi pulau ini dan
    mengetahui kebenaran di sebalik terperangkapnya dirimu?\n\nSetiap pilihan membawamu
    lebih dekat kepada kebebasan \u2014 atau semakin jauh ke dalam cengkaman pulau
    ini."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 499cf83f07b1eca49b41b4b547540c38, type: 2}
  m_sharedMaterial: {fileID: 7543850439555462583, guid: 499cf83f07b1eca49b41b4b547540c38,
